    advanceType: 0
    requiredSignal: 0
    hasAlternateSignal: 0
    alternateRequiredSignal: 0
    requiredBuilding: {fileID: 0}
  - description: "\uD558\uC9C0\uB9CC \uAD1C\uCC2E\uC2B5\uB2C8\uB2E4. \uB9C8\uC74C\uC5D0
      \uB4E4\uC9C0 \uC54A\uB294 \uAC74\uBB3C\uC740 \uD30C\uAD34\uD560 \uC218 \uC788\uC5B4\uC694.\n\uD30C\uAD34
      \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694!"
