    requiredBuilding: {fileID: 0}
  - description: "\uD30C\uAD34 \uBAA8\uB4DC\uC5D0\uC11C \uAC74\uBB3C\uC744 \uD074\uB9AD\uD558\uBA74
      \uCCA0\uAC70\uB429\uB2C8\uB2E4.\n'\uC5BC\uC74C \uB3D9\uAD74'\uC744 \uD074\uB9AD\uD574
      \uCCA0\uAC70\uD574\uBCF4\uC138\uC694."
