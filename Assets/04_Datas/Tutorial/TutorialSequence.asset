  m_Script: {fileID: 11500000, guid: 5ff95706bdaca4f308d233130eb95080, type: 3}
  m_Name: TutorialSequence
  m_EditorClassIdentifier: Assembly-CSharp::TutorialSequenceSO
  steps:
  - description: "\uB9C8\uC74C \uC5EC\uB9B0 \uC2E0\uC774\uC2DC\uC5EC.\n\uBC14\uBCA8\uD0D1\uC744
      \uC9C0\uC5B4 \uC2E0\uC758 \uAD8C\uC704\uC5D0 \uB3C4\uC804\uD558\uB824\uB294
      \uC778\uAC04\uC744 \uAC00\uC5FD\uAC8C \uC5EC\uAE30\uC2DC\uACE0\n\uC544\uB984\uB2E4\uC6B4
      \uAC74\uCD95\uBB3C\uC744 \uD1B5\uD574 \uC778\uAC04\uC744 \uB2E4\uB978 \uAE38\uB85C
      \uC774\uB04C\uB824 \uD558\uC2DC\uB124\u2026."
    hideDescription: 0
    highlightTarget: 0
    advanceType: 0
    requiredSignal: 0
    hasAlternateSignal: 0
    alternateRequiredSignal: 0
    requiredBuilding: {fileID: 0}
  - description: "\u2026\u2026."
    hideDescription: 0
    highlightTarget: 0
    advanceType: 0
    requiredSignal: 0
    hasAlternateSignal: 0
    alternateRequiredSignal: 0
    requiredBuilding: {fileID: 0}
  - description: "\uD654\uBA74 \uC67C\uCABD \uC704\uC5D0\uB294 \uC5F0\uCC28\uC640
      \uD604\uC7AC \uACC4\uC808\uC774 \uD45C\uC2DC\uB429\uB2C8\uB2E4.\n\n\uD654\uBA74\uC744
      \uD074\uB9AD\uD574 \uACC4\uC18D\uD558\uC138\uC694."
    hideDescription: 0
    highlightTarget: 1
    advanceType: 0
    requiredSignal: 0
    hasAlternateSignal: 0
    alternateRequiredSignal: 0
    requiredBuilding: {fileID: 0}
  - description: "\uD654\uBA74 \uC624\uB978\uCABD \uC704\uC5D0\uB294 '\uBBFF\uC74C(Faith)'\uC774
      \uD45C\uC2DC\uB429\uB2C8\uB2E4.\n\uBBFF\uC74C\uC740 \uAC74\uBB3C\uC744 \uAC74\uC124\uD558\uB294
      \uB370 \uC0AC\uC6A9\uB429\uB2C8\uB2E4.\n\n\uD654\uBA74\uC744 \uD074\uB9AD\uD574
      \uACC4\uC18D\uD558\uC138\uC694."
    hideDescription: 0
    highlightTarget: 2
    advanceType: 0
    requiredSignal: 0
    hasAlternateSignal: 0
    alternateRequiredSignal: 0
    requiredBuilding: {fileID: 0}
  - description: "\uBBFF\uC74C\uC740 \uB9E4 \uC6E8\uC774\uBE0C\uB9C8\uB2E4 \uC77C\uC815\uB7C9
      \uC0DD\uC0B0\uB418\uBA70,\n'\uC81C\uB2E8'\uC774\uB098 '\uC2E0\uC804' \uB4F1\uC758
      \uC2E0\uC131 \uAC74\uBB3C\uC5D0\uC11C\uB3C4 \uC0DD\uC0B0\uB429\uB2C8\uB2E4.\n\n\uD654\uBA74\uC744
      \uD074\uB9AD\uD574 \uACC4\uC18D\uD558\uC138\uC694."
    hideDescription: 0
    highlightTarget: 2
    advanceType: 0
    requiredSignal: 0
    hasAlternateSignal: 0
    alternateRequiredSignal: 0
    requiredBuilding: {fileID: 0}
  - description: "\uC624\uB978\uCABD \uD328\uB110\uC5D0\uB294 '\uC2E4\uD589', '\uAC74\uC124', 
      '\uD30C\uAD34' \uBC84\uD2BC\uC774 \uC788\uC2B5\uB2C8\uB2E4.\n\uC2E4\uD589 \uBC84\uD2BC
      \uC704\uC5D0\uB294 \uB2E4\uC74C \uC6E8\uC774\uBE0C\uC5D0\uC11C \uB098\uC62C
      \uC778\uAC04\uC758 \uC218\uAC00 \uD45C\uC2DC\uB429\uB2C8\uB2E4.\n\n\uD654\uBA74\uC744
      \uD074\uB9AD\uD574 \uACC4\uC18D\uD558\uC138\uC694."
    hideDescription: 0
    highlightTarget: 3
    advanceType: 0
    requiredSignal: 0
    hasAlternateSignal: 0
    alternateRequiredSignal: 0
    requiredBuilding: {fileID: 0}
  - description: "\uAC74\uC124 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uAC74\uBB3C \uBAA9\uB85D\uC744
      \uC5F4\uC5B4\uBCF4\uC138\uC694!"
    hideDescription: 0
    highlightTarget: 4
    advanceType: 1
    requiredSignal: 0
    hasAlternateSignal: 0
    alternateRequiredSignal: 0
    requiredBuilding: {fileID: 0}
  - description: "\uAC74\uBB3C \uCE74\uB4DC\uC5D0 \uC190\uC744 \uB300\uBA74 \uC815\uBCF4\uB97C
      \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uD654\uBA74\uC744 \uD074\uB9AD\uD574
      \uACC4\uC18D\uD558\uC138\uC694."
    hideDescription: 0
    highlightTarget: 5
    advanceType: 0
    requiredSignal: 0
    hasAlternateSignal: 0
    alternateRequiredSignal: 0
    requiredBuilding: {fileID: 0}
  - description: "\uC778\uAC04\uC774 \uAC74\uBB3C\uC744 \uC774\uC6A9\uD558\uB294
      \uC2DC\uAC04, \uAC74\uBB3C\uC744 \uAC74\uC124\uD558\uAE30 \uC704\uD574 \uD544\uC694\uD55C
      \uC2E0\uC559\uC758 \uD798,\n\uADF8\uB9AC\uACE0 \uACC4\uC808\uBCC4\uB85C \uB4E4\uC5B4\uC62C
      \uC218 \uC788\uB294 \uC778\uAC04\uC758 \uC218\uAC00 \uB098\uD0C0\uB0A9\uB2C8\uB2E4.\n\n\uD654\uBA74\uC744
      \uD074\uB9AD\uD574 \uACC4\uC18D\uD558\uC138\uC694."
    hideDescription: 0
    highlightTarget: 0
    advanceType: 0
    requiredSignal: 0
    hasAlternateSignal: 0
    alternateRequiredSignal: 0
    requiredBuilding: {fileID: 0}
  - description: "\uAC74\uBB3C \uCE74\uB4DC\uB97C \uB4DC\uB798\uADF8\uD558\uC5EC
      \uAC74\uC124 \uC2A4\uD3FF\uC5D0 \uB193\uC73C\uBA74 \uC124\uCE58\uB429\uB2C8\uB2E4.\n'\uC81C\uB2E8'\uC744
      \uB4DC\uB798\uADF8\uD574 \uB178\uB780\uC0C9 \uC2A4\uD3FF\uC5D0 \uC124\uCE58\uD574\uBCF4\uC138\uC694!"
    hideDescription: 0
    highlightTarget: 0
    advanceType: 1
    requiredSignal: 1
    hasAlternateSignal: 0
    alternateRequiredSignal: 0
    requiredBuilding: {fileID: 11400000, guid: 3cc097738bc6240c8bedc6c1bfdacc10, type: 2}
  - description: "'\uC2E4\uD589' \uB2E4\uC774\uC2A4\uB97C \uAD74\uB824 \uCCAB \uBC88\uC9F8
      \uC6E8\uC774\uBE0C\uB97C \uC2DC\uC791\uD558\uC138\uC694!"
    hideDescription: 0
    highlightTarget: 6
    advanceType: 1
    requiredSignal: 3
    hasAlternateSignal: 0
    alternateRequiredSignal: 0
    requiredBuilding: {fileID: 0}
  - description: 
    hideDescription: 1
    highlightTarget: 0
    advanceType: 1
    requiredSignal: 4
    hasAlternateSignal: 0
    alternateRequiredSignal: 0
    requiredBuilding: {fileID: 0}
  - description: "\uC6E8\uC774\uBE0C\uAC00 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4!\n\uC6E8\uC774\uBE0C\uAC00
      \uB05D\uB098\uBA74 \uBC14\uBCA8\uD0D1\uC744 \uAC74\uC124\uD558\uB7EC \uC628
      '\uC778\uAC04\uC758 \uC218'\uB9CC\uD07C '\uC2E0\uC559'\uC774 \uB4E4\uC5B4\uC635\uB2C8\uB2E4."
    hideDescription: 0
    highlightTarget: 0
    advanceType: 0
    requiredSignal: 0
    hasAlternateSignal: 0
    alternateRequiredSignal: 0
    requiredBuilding: {fileID: 0}
  - description: "\uC815\uBE44 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uB2E4\uC74C \uC2DC\uAC04\uC73C\uB85C
      \uD5A5\uD558\uC138\uC694."
    hideDescription: 0
    highlightTarget: 7
